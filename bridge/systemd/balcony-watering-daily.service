[Unit]
Description=Evaluate the balcony watering schedule
Documentation=https://github.com/kandotrun/tree
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=balcony-watering
Group=balcony-watering
EnvironmentFile=/etc/balcony-watering.env
ExecStart=/opt/balcony-watering/venv/bin/water-tree-schedule
StateDirectory=balcony-watering
UMask=0077
TimeoutStartSec=5min

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
# Intentionally empty: this service is activated by the disabled-by-default timer.
