# LAN-only device target
ATOM_URL=http://192.168.1.50

# Runtime state. Keep this file and the SQLite DB out of Git.
PUBLIC_DATABASE_PATH=~/.local/share/balcony-watering/public.db

# The gateway must remain loopback-only behind cloudflared.
PUBLIC_LISTEN_HOST=127.0.0.1
PUBLIC_LISTEN_PORT=8787
PUBLIC_ORIGIN=https://tree.example.com

# Bounded anonymous operation. Runtime configuration may only tighten these bounds.
PUBLIC_WATER_DURATION_SEC=10
PUBLIC_COOLDOWN_SEC=60
PUBLIC_HOURLY_LIMIT=6
PUBLIC_DAILY_LIMIT=24

ATOM_CONNECT_TIMEOUT_SEC=3
ATOM_REQUEST_TIMEOUT_SEC=5
